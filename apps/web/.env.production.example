# ==============================================================================
# Web app: production settings (Dokploy)
#
# Two kinds, and they live in different places on Dokploy:
#
#  1. BUILD ARGUMENTS ("Build-time Arguments" of the application). Next.js writes these into the
#     build, so changing one needs a REBUILD (Deploy), not just a restart.
#  2. ENVIRONMENT VARIABLES (the "Environment" tab). Read when the server runs.
#
# Full walkthrough: docs/deploy/DOKPLOY.md
# ==============================================================================

# ---- 1. Build arguments -------------------------------------------------------------------------
# Public address of this site.
NEXT_PUBLIC_SITE_URL=https://example.com
# Public address of the API. The browser calls it directly (login, booking, customer gallery).
NEXT_PUBLIC_API_URL=https://api.example.com
# Public address of the image bucket, including the bucket name. It is also the list of image hosts
# Next.js may optimize, so it must match the API's S3_PUBLIC_URL.
S3_PUBLIC_URL=https://cdn.example.com/photography-assets
# Optional. Where customers' gallery links point; leave out to use "<WEB_URL>/gallery" from the API.
# NEXT_PUBLIC_GALLERY_BASE_URL=https://example.com/gallery

# ---- 2. Environment variables -------------------------------------------------------------------
# Address of the API from the web app's SERVER, on Dokploy's private network (the API application's
# name as Dokploy shows it). Faster and not exposed to the internet. Leave out to use
# NEXT_PUBLIC_API_URL instead, which also works.
API_INTERNAL_URL=http://API_APP_NAME:3000
# Same value as the API's WEB_REVALIDATE_SECRET.
REVALIDATE_SECRET=
