# Server
PORT=3000
NODE_ENV=development

# Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photography_db?schema=public"
REDIS_URL="redis://localhost:6379"
BETTER_AUTH_URL=http://localhost:3002
WEB_URL=http://localhost:3000
# Next.js ISR invalidation webhook.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate/cms
WEB_REVALIDATE_SECRET=change-me
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
PAYMENT_CONFIG_ENCRYPTION_KEY=
# Optional generic alias for new deployments; PAYMENT_CONFIG_ENCRYPTION_KEY takes precedence.
CONFIG_ENCRYPTION_KEY=
OUTBOX_DELIVERY_MODE=log
# Only the API process should run migrations; worker processes set this to false.
RUN_DB_MIGRATIONS=true

# WhatsApp (WAHA) delivery. Keep these server-only; never expose to Next.js.
WAHA_ENABLED=false
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_ADMIN_CHAT_ID=

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9001
S3_PUBLIC_URL=http://localhost:9001/photography-assets
S3_BUCKET=photography-assets
S3_PRIVATE_BUCKET=photography-private
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
