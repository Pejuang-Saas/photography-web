datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  photos           Photo[]
  sessions         Session[]
  accounts         Account[]
  verifiedBookings Booking[]      @relation("BookingVerifiedBy")
  verifiedPayments Payment[]      @relation("PaymentVerifiedBy")
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@map("users")
}

enum PaymentMode {
  GATEWAY
  MANUAL
}

enum GatewayProvider {
  MOCK
  MIDTRANS
  XENDIT
}

enum GatewayEnvironment {
  SANDBOX
  PRODUCTION
}

enum PaymentPlan {
  DP_50
  FULL
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  WAITING_CONFIRMATION
  PAID_DP
  PAID_FULL
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  GATEWAY
  BANK_TRANSFER
  E_WALLET
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum NotificationType {
  BOOKING_NEW
  PAYMENT_PROOF
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  BOOKING_EXPIRED
  SYSTEM
}

enum StorageBucket {
  PUBLIC
  PRIVATE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum GatewayWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model ServicePackage {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  category        String?
  price           Int
  durationMinutes Int      @default(60) @map("duration_minutes")
  maxPeople       Int      @default(1) @map("max_people")
  features        Json?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([isActive, createdAt])
  @@map("service_packages")
}

model PaymentSetting {
  id                    String              @id @default("default")
  activeMode            PaymentMode         @default(MANUAL) @map("active_mode")
  allowDownPayment      Boolean             @default(true) @map("allow_down_payment")
  gatewayProvider       GatewayProvider?    @map("gateway_provider")
  gatewayEnvironment    GatewayEnvironment? @map("gateway_environment")
  merchantId            String?             @map("merchant_id")
  clientKey             String?             @map("client_key")
  serverKeyEncrypted    String?             @map("server_key_encrypted")
  publicKey             String?             @map("public_key")
  secretKeyEncrypted    String?             @map("secret_key_encrypted")
  webhookTokenEncrypted String?             @map("webhook_token_encrypted")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@map("payment_settings")
}

model EmailSetting {
  id              String   @id @default("default")
  enabled         Boolean  @default(false)
  autoSendInvoice Boolean  @default(true) @map("auto_send_invoice")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

model EmailTemplate {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  description         String?
  subject             String
  heading             String
  bodyText            String   @map("body_text")
  includeBookingTable Boolean  @default(false) @map("include_booking_table")
  ctaText             String?  @map("cta_text")
  ctaUrl              String?  @map("cta_url")
  ctaColor            String   @default("#d9a521") @map("cta_color")
  footerText          String?  @map("footer_text")
  isActive            Boolean  @default(true) @map("is_active")
  isSystem            Boolean  @default(false) @map("is_system")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model EmailLog {
  id           String         @id @default(uuid())
  dedupeKey    String         @unique @map("dedupe_key")
  to           String
  subject      String
  text         String
  html         String?
  attachments  Json?
  templateCode String?        @map("template_code")
  bookingId    String?        @map("booking_id")
  status       EmailLogStatus @default(QUEUED)
  attempts     Int            @default(0)
  error        String?
  sentAt       DateTime?      @map("sent_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("email_logs")
}

/// A label an admin puts on a WhatsApp conversation (for example "Booking DP"), with a badge colour.
model CrmCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("zinc")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  chats WhatsappChat[]

  @@map("crm_categories")
}

/// One conversation with a customer, as WAHA sees it. Groups and broadcasts are never stored.
model WhatsappChat {
  id                 String    @id @default(uuid())
  /// WAHA's id for the conversation: 6281...@c.us, or a ...@lid for contacts hidden behind a LID.
  chatId             String    @unique @map("chat_id")
  /// The customer's number as digits starting with 62, once known. Used to find their booking.
  phone              String?
  name               String?
  categoryId         String?   @map("category_id")
  lastMessageAt      DateTime? @map("last_message_at")
  /// When the customer last wrote to us. The 24-hour messaging window counts from here.
  lastInboundAt      DateTime? @map("last_inbound_at")
  lastMessagePreview String?   @map("last_message_preview")
  lastMessageFromMe  Boolean   @default(false) @map("last_message_from_me")
  /// Messages from the customer that no admin has opened yet.
  unreadCount        Int       @default(0) @map("unread_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  category CrmCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages WhatsappMessage[]

  @@index([lastMessageAt])
  @@index([phone])
  @@index([categoryId])
  @@map("whatsapp_chats")
}

/// An approved message the studio may send when the 24-hour window is closed. The body uses
/// {placeholders} that are filled in on the server from the conversation and its booking.
model WhatsappTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  body      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_templates")
}

model WhatsappMessage {
  id            String   @id @default(uuid())
  /// WAHA's message id, unique so the same message arriving by webhook and by sync is stored once.
  wahaId        String   @unique @map("waha_id")
  chatId        String   @map("chat_id")
  fromMe        Boolean  @map("from_me")
  body          String   @default("")
  hasMedia      Boolean  @default(false) @map("has_media")
  /// WAHA delivery state: -1 error, 0 pending, 1 sent, 2 delivered, 3 read, 4 played.
  ack           Int      @default(0)
  timestamp     DateTime
  /// Attachment details. The file itself is copied to private storage the first time it is needed.
  mediaMime     String?  @map("media_mime")
  mediaFilename String?  @map("media_filename")
  mediaKey      String?  @map("media_key")
  /// Why the last attempt to copy the file failed, so a broken one is not retried in a loop.
  mediaError    String?  @map("media_error")
  createdAt     DateTime @default(now()) @map("created_at")

  chat WhatsappChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, timestamp])
  @@map("whatsapp_messages")
}

model StudioSetting {
  id              String   @id @default("default")
  studioName      String   @default("Kayastory Photography") @map("studio_name")
  whatsappNumber  String?  @map("whatsapp_number")
  address         String?
  mapsUrl         String?  @map("maps_url")
  instagramHandle String?  @map("instagram_handle")
  city            String?
  region          String?
  openTime        String?  @map("open_time")
  closeTime       String?  @map("close_time")
  guarantees      Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("studio_settings")
}

model LandingContent {
  id        String   @id @default("default")
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("landing_content")
}

model ManualPaymentAccount {
  id            String   @id @default(uuid())
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountHolder String   @map("account_holder")
  isActive      Boolean  @default(true) @map("is_active")
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@index([isActive, isPrimary])
  @@map("manual_payment_accounts")
}

model Booking {
  id              String        @id @default(uuid())
  bookingCode     String        @unique @map("booking_code")
  customerName    String        @map("customer_name")
  customerPhone   String        @map("customer_phone")
  customerEmail   String        @map("customer_email")
  notes           String?
  idempotencyKey  String?       @unique @map("idempotency_key")
  idempotencyHash String?       @map("idempotency_hash")
  packageId       String        @map("package_id")
  packageName     String        @map("package_name")
  packagePrice    Int           @map("package_price")
  totalAmount     Int           @map("total_amount")
  paymentMode     PaymentMode   @map("payment_mode")
  paymentPlan     PaymentPlan   @map("payment_plan")
  requiredAmount  Int           @map("required_amount")
  sessionDate     DateTime      @map("session_date") @db.Date
  timeSlot        String        @map("time_slot")
  reservationKey  String?       @unique @map("reservation_key")
  status          BookingStatus @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  expiresAt       DateTime?     @map("expires_at")
  verifiedById    String?       @map("verified_by_id")
  verifiedAt      DateTime?     @map("verified_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  package       ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  verifiedBy    User?          @relation("BookingVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  payments      Payment[]
  invoice       Invoice?
  notifications Notification[]

  @@index([status, createdAt])
  @@index([sessionDate, timeSlot])
  @@map("bookings")
}

model Payment {
  id                String           @id @default(uuid())
  bookingId         String           @map("booking_id")
  manualAccountId   String?          @map("manual_account_id")
  method            PaymentMethod
  provider          GatewayProvider?
  plan              PaymentPlan
  amount            Int
  status            PaymentStatus
  senderName        String?          @map("sender_name")
  externalReference String?          @unique @map("external_reference")
  idempotencyKey    String?          @unique @map("idempotency_key")
  idempotencyHash   String?          @map("idempotency_hash")
  rejectionReason   String?          @map("rejection_reason")
  verifiedById      String?          @map("verified_by_id")
  verifiedAt        DateTime?        @map("verified_at")
  paidAt            DateTime?        @map("paid_at")
  metadata          Json?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  booking       Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  manualAccount ManualPaymentAccount? @relation(fields: [manualAccountId], references: [id], onDelete: SetNull)
  verifiedBy    User?                 @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  proof         PaymentProof?

  @@index([bookingId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model GatewayWebhookEvent {
  id            String               @id @default(uuid())
  provider      GatewayProvider
  eventKey      String               @unique @map("event_key")
  transactionId String?              @map("transaction_id")
  orderId       String?              @map("order_id")
  status        GatewayWebhookStatus @default(RECEIVED)
  payload       Json
  error         String?
  receivedAt    DateTime             @default(now()) @map("received_at")
  processedAt   DateTime?            @map("processed_at")

  @@index([provider, transactionId])
  @@index([provider, orderId])
  @@index([status, receivedAt])
  @@map("gateway_webhook_events")
}

model PaymentProof {
  id         String   @id @default(uuid())
  paymentId  String   @unique @map("payment_id")
  storageKey String   @map("storage_key")
  filename   String
  mimeType   String   @map("mime_type")
  size       Int
  createdAt  DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}

model Invoice {
  id            String        @id @default(uuid())
  bookingId     String        @unique @map("booking_id")
  invoiceNumber String        @unique @map("invoice_number")
  amount        Int
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?          @map("user_id")
  bookingId String?          @map("booking_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([bookingId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model StorageCleanup {
  id            String        @id @default(uuid())
  bucket        StorageBucket
  storageKey    String        @unique @map("storage_key")
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at")
  lastError     String?       @map("last_error")
  cleanedAt     DateTime?     @map("cleaned_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([cleanedAt, nextAttemptAt])
  @@map("storage_cleanup")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventKey      String       @unique @map("event_key")
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  lastError     String?      @map("last_error")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Photo {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String
  category    String?
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("photos")
}

model MediaAsset {
  id        String   @id @default(uuid())
  key       String   @unique
  url       String
  filename  String
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  galleryItems GalleryItem[]
  testimonials Testimonial[]

  @@map("media_assets")
}

model GalleryCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  galleryItems GalleryItem[]

  @@map("gallery_categories")
}

model GalleryItem {
  id           String    @id @default(uuid())
  title        String
  altText      String    @map("alt_text")
  caption      String?
  location     String?
  categoryId   String?   @map("category_id")
  mediaAssetId String    @map("media_asset_id")
  sortOrder    Int       @default(0) @map("sort_order")
  isFeatured   Boolean   @default(false) @map("is_featured")
  isPublished  Boolean   @default(false) @map("is_published")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  category   GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mediaAsset MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([isPublished, sortOrder])
  @@map("gallery_items")
}

model MarqueeItem {
  id        String   @id @default(uuid())
  text      String
  linkUrl   String?  @map("link_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("marquee_items")
}

model Testimonial {
  id           String   @id @default(uuid())
  customerName String   @map("customer_name")
  customerRole String?  @map("customer_role")
  university   String?
  quote        String
  rating       Int      @default(5)
  mediaAssetId String?  @map("media_asset_id")
  sortOrder    Int      @default(0) @map("sort_order")
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@map("testimonials")
}

model FaqItem {
  id          String   @id @default(uuid())
  question    String
  answer      String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("faq_items")
}
