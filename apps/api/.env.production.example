# ==============================================================================
# API and worker: production environment (Dokploy -> the application's "Environment" tab)
#
# Both applications (the API and the worker) read the same variables; give the worker the same
# list. Generate secrets with:  openssl rand -hex 32
# Full walkthrough: docs/deploy/DOKPLOY.md
# ==============================================================================

NODE_ENV=production
PORT=3000

# ---- Database and queue (Dokploy -> Databases; use the INTERNAL host name shown there) ---------
DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_HOST:5432/DBNAME?schema=public"
REDIS_URL="redis://:PASSWORD@REDIS_HOST:6379"

# ---- Public addresses ---------------------------------------------------------------------------
# The API's own public address (what the browser calls), no trailing slash.
BETTER_AUTH_URL=https://api.example.com
API_URL=https://api.example.com
# The web app's public address, EXACTLY as the browser shows it (www or not, https). It is the one
# origin allowed to call the API with a login, so a mismatch shows up as "login does nothing".
WEB_URL=https://example.com
# Set when web and API are different subdomains of one site, so the login cookie reaches the web
# app: the parent domain with a leading dot. Leave empty if both are on the same host.
AUTH_COOKIE_DOMAIN=.example.com

# ---- Secrets ------------------------------------------------------------------------------------
# At least 32 characters. Changing it signs every admin out.
BETTER_AUTH_SECRET=
# Encrypts payment gateway keys and similar secrets stored in the database. Back it up: without it
# those saved settings cannot be read again.
PAYMENT_CONFIG_ENCRYPTION_KEY=

# ---- Object storage (MinIO on Dokploy, or any S3-compatible service) ----------------------------
# Address of the storage as seen from the API (the internal service name for MinIO).
S3_ENDPOINT=http://MINIO_HOST:9000
# Address the BROWSER uses to load images: the public bucket URL, including the bucket name.
S3_PUBLIC_URL=https://cdn.example.com/photography-assets
S3_BUCKET=photography-assets
S3_PRIVATE_BUCKET=photography-private
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Telling the web app to refresh after an admin edit -----------------------------------------
# Address of the web app's revalidate endpoint (internal is fine) and the shared secret. The web
# app needs the same secret as REVALIDATE_SECRET.
WEB_REVALIDATE_URL=http://WEB_APP_NAME:3000/api/revalidate/cms
WEB_REVALIDATE_SECRET=

# ---- Behind the proxy ---------------------------------------------------------------------------
# How many reverse proxies sit in front of the API: 1 for Dokploy's Traefik alone (the default in
# production), 2 with Cloudflare in front of it. Wrong values make the rate limit count every
# visitor as one client (too low) or let a visitor choose their own address (too high).
# TRUST_PROXY_HOPS=1

# ---- Email (worker) -----------------------------------------------------------------------------
# disabled = deliver nothing (the default in production), log = write to the log only,
# live = really send through the SMTP server below.
OUTBOX_DELIVERY_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
EMAIL_RATE_LIMIT_PER_MINUTE=20

# ---- WhatsApp through WAHA (optional) -----------------------------------------------------------
WAHA_ENABLED=false
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_ADMIN_CHAT_ID=
# The address of THIS API as the WAHA container reaches it, and the secret that signs its webhooks.
WAHA_WEBHOOK_URL=http://API_APP_NAME:3000/webhooks/waha
WAHA_WEBHOOK_SECRET=
WHATSAPP_SEND_LIMIT_PER_MINUTE=20

# ---- Limits and housekeeping (defaults shown) ----------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
THROTTLE_BLOCK_DURATION_SECONDS=60
QUEUE_ALERT_INTERVAL_SECONDS=60
QUEUE_FAILED_ALERT_THRESHOLD=1
# Only the API applies migrations; the worker image already sets this to false.
# RUN_DB_MIGRATIONS=true
# How long the container waits for PostgreSQL before it gives up (2 seconds per attempt).
# DB_WAIT_ATTEMPTS=30
