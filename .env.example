# ==============================================================================
# Photography Monorepo Environment Variables
# ==============================================================================

# Application URLs (No raw ports, using complete URLs)
API_URL=http://localhost:3002
BETTER_AUTH_SECRET=
PAYMENT_CONFIG_ENCRYPTION_KEY=
# Optional generic alias for new deployments; PAYMENT_CONFIG_ENCRYPTION_KEY takes precedence.
CONFIG_ENCRYPTION_KEY=
# log = only write notifications to the worker log (default for development, nothing is sent)
# live = really deliver them: email goes through the SMTP server configured below
# disabled = refuse to deliver (default in production until you opt in with `live`)
# For development, use `live` together with the Mailpit container (the SMTP defaults below point at it).
OUTBOX_DELIVERY_MODE=log
# Emails the worker may send per minute; keep it under your SMTP provider's limit.
EMAIL_RATE_LIMIT_PER_MINUTE=20
# SMTP server. Set here (never in the admin panel); the admin only manages templates and switches.
# SMTP_HOST and SMTP_FROM_EMAIL are required; SMTP_USER needs SMTP_PASSWORD. Port 465 = implicit TLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=studio@kayastory.test
SMTP_FROM_NAME=Kayastory Photography
# Only the API process should run migrations; worker processes set this to false.
RUN_DB_MIGRATIONS=true
QUEUE_ALERT_INTERVAL_SECONDS=60
QUEUE_FAILED_ALERT_THRESHOLD=1

# WhatsApp (WAHA) delivery. Keep these server-only; never expose to Next.js.
# WAHA_ENABLED only switches automatic notifications over WhatsApp. Connecting the studio number
# from the admin panel (Otomasi WhatsApp) works as soon as WAHA_BASE_URL and WAHA_API_KEY are set.
WAHA_ENABLED=false
# Address of WAHA as seen from the host. Inside Docker the compose file uses WAHA_DOCKER_URL instead.
WAHA_BASE_URL=http://localhost:3001
WAHA_DOCKER_URL=http://dev-waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_ADMIN_CHAT_ID=
# Incoming WhatsApp messages (the CRM) arrive as signed webhooks from WAHA. Generate the secret with
# `openssl rand -hex 32`. WAHA_WEBHOOK_URL is the API address as seen from the WAHA container.
WAHA_WEBHOOK_SECRET=
WAHA_WEBHOOK_URL=http://photography-api:3000/webhooks/waha
# Messages the CRM may send per minute, counting everything the studio sent; keeps the number safe.
WHATSAPP_SEND_LIMIT_PER_MINUTE=20
WEB_URL=http://localhost:3000
# Optional. Where the gallery sync reads public Google Drive folders from (tests point it elsewhere).
# DRIVE_BASE_URL=https://drive.google.com
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate/cms
WEB_REVALIDATE_SECRET=change-me
REVALIDATE_SECRET=change-me

# Infrastructure & Database (connected via dev-network)
DATABASE_URL="postgresql://root:root@dev-postgres:5432/photography_db?schema=public"
REDIS_URL="redis://dev-redis:6379"

# API throttling: 60 requests per IP per minute, then block for one minute.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
THROTTLE_BLOCK_DURATION_SECONDS=60

# Object storage (MinIO in Docker Compose)
S3_PUBLIC_URL=http://localhost:9001/photography-assets
S3_BUCKET=photography-assets
S3_PRIVATE_BUCKET=photography-private
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
