# ==============================================================================
# Photography Monorepo Environment Variables
# ==============================================================================

# Application URLs (No raw ports, using complete URLs)
API_URL=http://localhost:3002
BETTER_AUTH_SECRET=
PAYMENT_CONFIG_ENCRYPTION_KEY=
# Optional generic alias for new deployments; PAYMENT_CONFIG_ENCRYPTION_KEY takes precedence.
CONFIG_ENCRYPTION_KEY=
OUTBOX_DELIVERY_MODE=log
# Only the API process should run migrations; worker processes set this to false.
RUN_DB_MIGRATIONS=true

# WhatsApp (WAHA) delivery. Keep these server-only; never expose to Next.js.
WAHA_ENABLED=false
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_ADMIN_CHAT_ID=
WEB_URL=http://localhost:3000
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate/cms
WEB_REVALIDATE_SECRET=change-me
REVALIDATE_SECRET=change-me

# Infrastructure & Database (connected via dev-network)
DATABASE_URL="postgresql://root:root@dev-postgres:5432/photography_db?schema=public"
REDIS_URL="redis://dev-redis:6379"

# API throttling: 60 requests per IP per minute, then block for one minute.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
THROTTLE_BLOCK_DURATION_SECONDS=60

# Object storage (MinIO in Docker Compose)
S3_PUBLIC_URL=http://localhost:9001/photography-assets
S3_BUCKET=photography-assets
S3_PRIVATE_BUCKET=photography-private
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
