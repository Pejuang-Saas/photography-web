# ==============================================================================
# Photography Monorepo Environment Variables
# ==============================================================================

# Application URLs (No raw ports, using complete URLs)
API_URL=http://localhost:3002
BETTER_AUTH_SECRET=
WEB_URL=http://localhost:3000

# Infrastructure & Database (connected via dev-network)
DATABASE_URL="postgresql://root:root@dev-postgres:5432/photography_db?schema=public"
REDIS_URL="redis://dev-redis:6379"

# API throttling: 60 requests per IP per minute, then block for one minute.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
THROTTLE_BLOCK_DURATION_SECONDS=60

# Object storage (MinIO in Docker Compose)
S3_PUBLIC_URL=http://localhost:9001/photography-assets
S3_BUCKET=photography-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
